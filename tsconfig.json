{
  // Type-checks the JavaScript with JSDoc annotations — nothing is compiled (`npm run typecheck`).
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["lib/**/*.js", "lib/**/*.d.ts", "server.js", "bin/**/*.js"]
}
