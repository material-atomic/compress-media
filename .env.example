# Copy to .env. It is read by `npm start` / `compress-media serve` (from the current folder)
# and by `docker compose`. Variables already set in the environment take precedence.
#
# Native runs use PORT / HOST; Compose publishes COMPRESS_MEDIA_PORT and ignores PORT.

# PORT=4747
# HOST=127.0.0.1
# JOB_TTL_HOURS=3
# MAX_UPLOAD_MB=0

# Image to run (default: runsnip/compress-media:latest from Docker Hub)
# COMPRESS_MEDIA_IMAGE=runsnip/compress-media:1.0.0

# Host port the web UI is published on
COMPRESS_MEDIA_PORT=4747
# Hours to keep uploads and results before they are deleted
JOB_TTL_HOURS=3
# Per-file upload limit in MB (0 = unlimited)
MAX_UPLOAD_MB=0
# Video/audio jobs processed in parallel (ffmpeg already uses every core)
MEDIA_CONCURRENCY=1

# Uploads are sent in parts (resumable, proxy-friendly). 5–100 MB suits S3 storage and Cloudflare.
UPLOAD_PART_MB=8
UPLOAD_CONCURRENCY=4

# Public address of the app (used to check bucket CORS when STORAGE=s3)
# PUBLIC_URL=https://media.example.com

# Where uploads and results go: local (disk) or s3 (any S3-compatible object storage)
STORAGE=local
# S3_BUCKET=
# S3_REGION=us-east-1                                  # "auto" for Cloudflare R2
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS
# S3_PUBLIC_ENDPOINT=                                  # if browsers reach storage at another address
# S3_FORCE_PATH_STYLE=false                            # true for MinIO / SeaweedFS
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=compress-media/
# S3_SETUP_CORS=false                                  # true: add the CORS rule for PUBLIC_URL at startup
